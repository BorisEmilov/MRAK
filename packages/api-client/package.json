{
  "name": "@mrak/api-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Typed client for services/online-api, generated from its OpenAPI spec.",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./edge-proxy": {
      "types": "./src/edge-proxy.ts",
      "default": "./src/edge-proxy.ts"
    }
  },
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "vitest": "5.1.0"
  }
}
