{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "$ref": "#/$defs/GlossaryEntry"
    },
    {
      "type": "array",
      "items": {
        "$ref": "#/$defs/GlossaryEntry"
      }
    }
  ],
  "$defs": {
    "GlossaryEntry": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "tier": {
          "type": "string",
          "enum": [
            "demo",
            "full"
          ]
        },
        "termKey": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)+$",
          "description": "Reference to a loc"
        },
        "descKey": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)+$",
          "description": "Reference to a loc"
        },
        "category": {
          "type": "string",
          "enum": [
            "folklore",
            "history",
            "game"
          ]
        },
        "origin": {
          "type": "string",
          "enum": [
            "folklore",
            "history",
            "invented"
          ]
        }
      },
      "required": [
        "id",
        "tier",
        "termKey",
        "descKey",
        "category",
        "origin"
      ],
      "additionalProperties": false
    }
  }
}
