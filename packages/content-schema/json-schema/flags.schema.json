{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/Registry",
  "$defs": {
    "Registry": {
      "type": "object",
      "properties": {
        "flags": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "description": {
                "type": "string",
                "minLength": 3
              }
            },
            "required": [
              "id",
              "description"
            ],
            "additionalProperties": false
          }
        },
        "stats": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "scope": {
                "type": "string",
                "enum": [
                  "guardian",
                  "village",
                  "villager",
                  "world",
                  "profile"
                ]
              },
              "min": {
                "type": "number"
              },
              "max": {
                "type": "number"
              },
              "default": {
                "type": "number"
              },
              "description": {
                "type": "string",
                "minLength": 3
              }
            },
            "required": [
              "id",
              "scope",
              "min",
              "max",
              "default",
              "description"
            ],
            "additionalProperties": false
          }
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "description": {
                "type": "string",
                "minLength": 3
              },
              "params": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "id",
              "description"
            ],
            "additionalProperties": false
          }
        },
        "contexts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "description": {
                "type": "string",
                "minLength": 3
              }
            },
            "required": [
              "id",
              "description"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "flags",
        "stats",
        "rules",
        "contexts"
      ],
      "additionalProperties": false
    }
  }
}
