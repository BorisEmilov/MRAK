{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "$ref": "#/$defs/Sin"
    },
    {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Sin"
      }
    }
  ],
  "$defs": {
    "Sin": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "tier": {
          "type": "string",
          "enum": [
            "demo",
            "full"
          ]
        },
        "nameKey": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)+$",
          "description": "Reference to a loc"
        },
        "descKey": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)+$",
          "description": "Reference to a loc"
        },
        "blocks": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "description": "Reference to a virtue"
          }
        }
      },
      "required": [
        "id",
        "tier",
        "nameKey",
        "descKey"
      ],
      "additionalProperties": false
    }
  }
}
