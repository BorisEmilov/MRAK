{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "$ref": "#/$defs/Villager"
    },
    {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Villager"
      }
    }
  ],
  "$defs": {
    "Villager": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "tier": {
          "type": "string",
          "enum": [
            "demo",
            "full"
          ]
        },
        "nameKey": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)+$",
          "description": "Reference to a loc"
        },
        "tradeKey": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)+$",
          "description": "Reference to a loc"
        },
        "bioKey": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)+$",
          "description": "Reference to a loc"
        },
        "age": {
          "type": "integer",
          "minimum": 0,
          "maximum": 110
        },
        "sex": {
          "type": "string",
          "enum": [
            "female",
            "male"
          ]
        },
        "traits": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "description": "Reference to a trait"
          }
        },
        "dialogue": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "fears": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "water",
              "fire",
              "dark",
              "death",
              "aga",
              "debt",
              "witchcraft",
              "solitude",
              "god-abandonment",
              "mill",
              "being-ridiculed"
            ]
          }
        },
        "startingFear": {
          "default": 10,
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "relationships": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "villager": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                "description": "Reference to a villager"
              },
              "affinity": {
                "type": "integer",
                "minimum": -100,
                "maximum": 100
              }
            },
            "required": [
              "villager",
              "affinity"
            ],
            "additionalProperties": false
          }
        },
        "secrets": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "descKey": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)+$",
                "description": "Reference to a loc"
              },
              "revealWhen": {
                "$ref": "#/$defs/Condition"
              }
            },
            "required": [
              "id",
              "descKey",
              "revealWhen"
            ],
            "additionalProperties": false
          }
        },
        "home": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "work": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "routine": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "description": "Reference to a routine"
        },
        "look": {
          "type": "object",
          "properties": {
            "skin": {
              "type": "string",
              "pattern": "^#[0-9a-f]{6}$"
            },
            "hair": {
              "type": "string",
              "pattern": "^#[0-9a-f]{6}$"
            },
            "clothes": {
              "type": "string",
              "pattern": "^#[0-9a-f]{6}$"
            },
            "accent": {
              "type": "string",
              "pattern": "^#[0-9a-f]{6}$"
            },
            "headwear": {
              "default": "none",
              "type": "string",
              "enum": [
                "none",
                "kerchief",
                "cap",
                "kalpak",
                "kalimavkion"
              ]
            },
            "beard": {
              "default": false,
              "type": "boolean"
            },
            "build": {
              "default": "slim",
              "type": "string",
              "enum": [
                "slim",
                "broad",
                "stooped"
              ]
            }
          },
          "required": [
            "skin",
            "hair",
            "clothes",
            "accent"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "tier",
        "nameKey",
        "tradeKey",
        "bioKey",
        "age",
        "sex",
        "fears",
        "home",
        "work",
        "routine",
        "look"
      ],
      "additionalProperties": false
    },
    "Condition": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "all": {
              "minItems": 1,
              "type": "array",
              "items": {
                "$ref": "#/$defs/Condition"
              }
            }
          },
          "required": [
            "all"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "any": {
              "minItems": 1,
              "type": "array",
              "items": {
                "$ref": "#/$defs/Condition"
              }
            }
          },
          "required": [
            "any"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "not": {
              "$ref": "#/$defs/Condition"
            }
          },
          "required": [
            "not"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "flag": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "description": "Reference to a flag"
            }
          },
          "required": [
            "flag"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "stat": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "description": "Reference to a stat"
            },
            "villager": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "description": "Reference to a villager"
            },
            ">=": {
              "type": "number"
            },
            ">": {
              "type": "number"
            },
            "<=": {
              "type": "number"
            },
            "<": {
              "type": "number"
            },
            "==": {
              "type": "number"
            },
            "!=": {
              "type": "number"
            }
          },
          "required": [
            "stat"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "hasItem": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "description": "Reference to a item"
            },
            "qty": {
              "type": "integer",
              "minimum": 1,
              "maximum": 999
            },
            "in": {
              "type": "string",
              "enum": [
                "pack",
                "storage"
              ]
            }
          },
          "required": [
            "hasItem"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "clue": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "description": "Reference to a clue"
            }
          },
          "required": [
            "clue"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "talent": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "description": "Reference to a talent"
            }
          },
          "required": [
            "talent"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "calling": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "description": "Reference to a calling"
            }
          },
          "required": [
            "calling"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "pactSigned": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "description": "Reference to a pact"
            }
          },
          "required": [
            "pactSigned"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "chapter": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "description": "Reference to a festival"
            }
          },
          "required": [
            "chapter"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "phase": {
              "type": "string",
              "enum": [
                "dawn",
                "day",
                "dusk",
                "night"
              ]
            }
          },
          "required": [
            "phase"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "villagerAlive": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "description": "Reference to a villager"
            }
          },
          "required": [
            "villagerAlive"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "possessionRevealed": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "description": "Reference to a villager"
            }
          },
          "required": [
            "possessionRevealed"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "quest": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "description": "Reference to a quest"
            },
            "status": {
              "type": "string",
              "enum": [
                "active",
                "done",
                "failed"
              ]
            },
            "stage": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            }
          },
          "required": [
            "quest"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "mysteryConcluded": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "description": "Reference to a mystery"
            },
            "correct": {
              "type": "boolean"
            },
            "culprit": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "description": "Reference to a villager"
            }
          },
          "required": [
            "mysteryConcluded"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "chance": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "chance"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "date": {
              "type": "object",
              "properties": {
                "from": {
                  "type": "string",
                  "pattern": "^(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
                },
                "to": {
                  "type": "string",
                  "pattern": "^(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
                }
              },
              "required": [
                "from",
                "to"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "date"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "moon": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "new",
                  "waxing-crescent",
                  "first-quarter",
                  "waxing-gibbous",
                  "full",
                  "waning-gibbous",
                  "last-quarter",
                  "waning-crescent"
                ]
              }
            }
          },
          "required": [
            "moon"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "festivalDay": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "description": "Reference to a festival"
            }
          },
          "required": [
            "festivalDay"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "collection": {
              "type": "string",
              "enum": [
                "herbs",
                "recipes",
                "grimoire",
                "relics",
                "tales",
                "songs",
                "cursed",
                "photos",
                "memories"
              ]
            },
            ">=": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "string",
                  "const": "all"
                }
              ]
            },
            ">": {
              "type": "number"
            },
            "<=": {
              "type": "number"
            },
            "<": {
              "type": "number"
            },
            "==": {
              "type": "number"
            },
            "!=": {
              "type": "number"
            }
          },
          "required": [
            "collection"
          ],
          "additionalProperties": false
        }
      ],
      "description": "Condition mini-language (docs/systems/conditions-effects.md)"
    }
  }
}
