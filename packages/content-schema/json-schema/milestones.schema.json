{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "$ref": "#/$defs/Milestone"
    },
    {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Milestone"
      }
    }
  ],
  "$defs": {
    "Milestone": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "tier": {
          "type": "string",
          "enum": [
            "demo",
            "full"
          ]
        },
        "reasonKey": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)+$",
          "description": "Reference to a loc"
        },
        "amount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "on": {
          "type": "object",
          "properties": {
            "event": {
              "type": "string",
              "enum": [
                "time/dawn",
                "time/chapterEnded",
                "world/zoneEntered",
                "photo/layerRevealed",
                "journal/learned",
                "alchemy/discovered",
                "mystery/clueFound",
                "journal/collectibleGranted",
                "collection/memoryRecalled",
                "cabinet/setCompleted",
                "collection/completed"
              ]
            },
            "match": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": [
                  "string",
                  "number",
                  "boolean"
                ]
              }
            }
          },
          "required": [
            "event"
          ],
          "additionalProperties": false
        },
        "repeat": {
          "default": "once",
          "type": "string",
          "enum": [
            "once",
            "per-target",
            "always"
          ]
        }
      },
      "required": [
        "id",
        "tier",
        "reasonKey",
        "amount"
      ],
      "additionalProperties": false
    }
  }
}
