            "portionsPerItem": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            },
            "coldReliefByDay": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "coldPerNightHour": {
              "type": "object",
              "properties": {
                "winter": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                "spring": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                "summer": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                "autumn": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                }
