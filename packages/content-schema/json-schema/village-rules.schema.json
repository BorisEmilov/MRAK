          "required": [
            "contagionRate",
            "contagionCap",
            "proximityWeight",
            "faithDamping",
            "tagMultiplier",
            "needFearPerHour",
            "darkFearPerHour",
            "solitudeFearPerHour",
            "deathOfCloseRelation",
            "deathInVillage",
            "closeAffinity",
            "returnedSighting",
            "decayPerDawn",
            "decayWhenHysterical",
            "hysteriaThreshold",
            "terrifiedAt",
            "calmBelow",
            "panicAt",
            "nightTaskMaxFear",
            "maskedFactor"
