              "minimum": 0,
              "maximum": 100
            },
            "unheatedFactor": {
              "type": "number",
              "minimum": 0,
              "maximum": 2
            },
            "firewoodItem": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "description": "Reference to a item"
            },
            "firewoodPerHome": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10
            },
            "faithDecayPerDay": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "prayFaithPerHour": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "threshold": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            }
          },
          "required": [
            "hungerPerHour",
            "mealRelief",
            "mealItem",
            "portionsPerItem",
            "coldReliefByDay",
            "coldPerNightHour",
            "warmthAtHome",
            "unheatedFactor",
            "firewoodItem",
            "firewoodPerHome",
            "faithDecayPerDay",
            "prayFaithPerHour",
            "threshold"
          ],
          "additionalProperties": false
