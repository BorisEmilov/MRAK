                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)+$",
                "description": "Reference to a loc"
              }
            },
            "secrets": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                  },
                  "descKey": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)+$",
                    "description": "Reference to a loc"
                  },
                  "minProsperity": {
                    "default": 1,
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 5
                  }
                },
                "required": [
                  "id",
                  "descKey"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "constructionTask",
            "prosperityLevels",
            "prosperity",
            "population",
            "names",
            "trades",
            "secrets"
          ],
          "additionalProperties": false
