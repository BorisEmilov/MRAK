        "possession": {
          "type": "object",
          "properties": {
            "sleepwalkPlace": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            },
            "sleepwalkFrom": {
              "type": "string",
              "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
            },
            "sleepwalkTo": {
              "type": "string",
              "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
            }
          },
          "required": [
            "sleepwalkPlace",
            "sleepwalkFrom",
            "sleepwalkTo"
          ],
          "additionalProperties": false
        },
        "growth": {
          "type": "object",
          "properties": {
            "constructionTask": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "description": "Reference to a task"
            },
            "prosperityLevels": {
              "minItems": 5,
              "maxItems": 5,
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 500
              }
            },
            "levelEffects": {
              "default": [],
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "level": {
                    "type": "integer",
                    "minimum": 2,
                    "maximum": 5
                  },
                  "effects": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/Effect"
                    }
                  }
                },
                "required": [
                  "level",
                  "effects"
                ],
                "additionalProperties": false
              }
            },
            "prosperity": {
              "type": "object",
              "properties": {
                "perResident": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 10
                },
                "chapterObserved": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100
                },
                "death": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100
                },
                "lynching": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100
                },
                "debtCollected": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100
                },
                "decayPerYear": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100
                }
              },
              "required": [
                "perResident",
                "chapterObserved",
                "death",
                "lynching",
                "debtCollected",
                "decayPerYear"
              ],
              "additionalProperties": false
            },
            "population": {
              "type": "object",
              "properties": {
                "adultAge": {
                  "type": "integer",
                  "minimum": 12,
                  "maximum": 21
                },
                "elderAge": {
                  "type": "integer",
                  "minimum": 40,
                  "maximum": 80
                },
                "maxAge": {
                  "type": "integer",
                  "minimum": 60,
                  "maximum": 110
                },
                "oldAgeDeath": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "marriageChance": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "birthChance": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "outsiderChance": {
                  "minItems": 5,
                  "maxItems": 5,
                  "type": "array",
                  "items": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                },
                "flightChance": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "cap": {
                  "type": "integer",
                  "minimum": 10,
                  "maximum": 500
                }
              },
              "required": [
                "adultAge",
                "elderAge",
                "maxAge",
                "oldAgeDeath",
                "marriageChance",
                "birthChance",
                "outsiderChance",
                "flightChance",
                "cap"
              ],
              "additionalProperties": false
            },
            "names": {
              "type": "object",
              "properties": {
                "female": {
                  "minItems": 4,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)+$",
                    "description": "Reference to a loc"
                  }
                },
                "male": {
                  "minItems": 4,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)+$",
