        "health": {
          "type": "object",
          "properties": {
            "lossPerHour": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "critical": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "regenPerHour": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "sickBelow": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "recoveredAt": {
              "type": "number",
