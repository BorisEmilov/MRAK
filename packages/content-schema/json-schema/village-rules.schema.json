                "type": "object",
                "properties": {
                  "item": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                    "description": "Reference to a item"
                  },
                  "qty": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 999
                  }
                },
                "required": [
                  "item",
                  "qty"
                ],
                "additionalProperties": false
              }
            },
            "layToRestItems": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "item": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                    "description": "Reference to a item"
