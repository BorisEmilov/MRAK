          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "tier": {
          "type": "string",
          "enum": [
            "demo",
            "full"
          ]
        },
        "zone": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "description": "Reference to a zone"
        },
        "fear": {
          "type": "object",
          "properties": {
            "contagionRate": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "contagionCap": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "proximityWeight": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "faithDamping": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "tagMultiplier": {
              "type": "number",
              "minimum": 1,
              "maximum": 5
            },
            "needFearPerHour": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "darkFearPerHour": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "solitudeFearPerHour": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "deathOfCloseRelation": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "deathInVillage": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "closeAffinity": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "returnedSighting": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "decayPerDawn": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "decayWhenHysterical": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "hysteriaThreshold": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "terrifiedAt": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "calmBelow": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "panicAt": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "nightTaskMaxFear": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "maskedFactor": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
