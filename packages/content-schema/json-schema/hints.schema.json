{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "$ref": "#/$defs/Hint"
    },
    {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Hint"
      }
    }
  ],
  "$defs": {
    "Hint": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "tier": {
          "type": "string",
          "enum": [
            "demo",
            "full"
          ]
        },
        "titleKey": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)+$",
          "description": "Reference to a loc"
        },
        "textKey": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)+$",
          "description": "Reference to a loc"
        },
        "icon": {
          "type": "string",
          "pattern": "^[a-z][a-z-]*\\.[a-z0-9][a-z0-9-]*$"
        },
        "phase": {
          "type": "string",
          "enum": [
            "prologue",
            "first-night",
            "contextual"
          ]
        },
        "on": {
          "type": "string",
          "enum": [
            "game-started",
            "zone-entered",
            "night-started",
            "dawn",
            "decision-recorded",
            "item-added",
            "stat-changed",
            "interaction-available",
            "low-sanity"
          ]
        },
        "when": {
          "$ref": "#/$defs/Condition"
        },
        "priority": {
          "default": 50,
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "glossary": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "description": "Reference to a glossary-term"
          }
        }
      },
      "required": [
        "id",
        "tier",
        "titleKey",
        "textKey",
        "phase",
        "on"
      ],
      "additionalProperties": false
    },
    "Condition": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "all": {
              "minItems": 1,
              "type": "array",
              "items": {
                "$ref": "#/$defs/Condition"
              }
            }
          },
          "required": [
            "all"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "any": {
              "minItems": 1,
              "type": "array",
              "items": {
                "$ref": "#/$defs/Condition"
              }
            }
          },
          "required": [
            "any"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "not": {
              "$ref": "#/$defs/Condition"
            }
          },
          "required": [
            "not"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "flag": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "description": "Reference to a flag"
            }
          },
          "required": [
            "flag"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "stat": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "description": "Reference to a stat"
            },
            "villager": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "description": "Reference to a villager"
            },
            ">=": {
              "type": "number"
            },
            ">": {
              "type": "number"
            },
            "<=": {
              "type": "number"
            },
            "<": {
              "type": "number"
            },
            "==": {
              "type": "number"
            },
            "!=": {
              "type": "number"
            }
          },
          "required": [
            "stat"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "hasItem": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "description": "Reference to a item"
            },
            "qty": {
              "type": "integer",
              "minimum": 1,
              "maximum": 999
            },
            "in": {
              "type": "string",
              "enum": [
                "pack",
                "storage"
              ]
            }
          },
          "required": [
            "hasItem"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "clue": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "description": "Reference to a clue"
            }
          },
          "required": [
            "clue"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "talent": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "description": "Reference to a talent"
            }
          },
          "required": [
            "talent"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "calling": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "description": "Reference to a calling"
            }
          },
          "required": [
            "calling"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "pactSigned": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "description": "Reference to a pact"
            }
          },
          "required": [
            "pactSigned"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "chapter": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "description": "Reference to a festival"
            }
          },
          "required": [
            "chapter"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "phase": {
              "type": "string",
              "enum": [
                "dawn",
                "day",
                "dusk",
                "night"
              ]
            }
          },
          "required": [
            "phase"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "villagerAlive": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "description": "Reference to a villager"
            }
          },
          "required": [
            "villagerAlive"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "possessionRevealed": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "description": "Reference to a villager"
            }
          },
          "required": [
            "possessionRevealed"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "quest": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "description": "Reference to a quest"
            },
            "status": {
              "type": "string",
              "enum": [
                "active",
                "done",
                "failed"
              ]
            },
            "stage": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            }
          },
          "required": [
            "quest"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "mysteryConcluded": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "description": "Reference to a mystery"
            },
            "correct": {
              "type": "boolean"
            },
            "culprit": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "description": "Reference to a villager"
            }
          },
          "required": [
            "mysteryConcluded"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "chance": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "chance"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "date": {
              "type": "object",
              "properties": {
                "from": {
                  "type": "string",
                  "pattern": "^(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
                },
                "to": {
                  "type": "string",
                  "pattern": "^(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
                }
              },
              "required": [
                "from",
                "to"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "date"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "moon": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "new",
                  "waxing-crescent",
                  "first-quarter",
                  "waxing-gibbous",
                  "full",
                  "waning-gibbous",
                  "last-quarter",
                  "waning-crescent"
                ]
              }
            }
          },
          "required": [
            "moon"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "festivalDay": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "description": "Reference to a festival"
            }
          },
          "required": [
            "festivalDay"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "collection": {
              "type": "string",
              "enum": [
                "herbs",
                "recipes",
                "grimoire",
                "relics",
                "tales",
                "songs",
                "cursed",
                "photos",
                "memories"
              ]
            },
            ">=": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "string",
                  "const": "all"
                }
              ]
            },
            ">": {
              "type": "number"
            },
            "<=": {
              "type": "number"
            },
            "<": {
              "type": "number"
            },
            "==": {
              "type": "number"
            },
            "!=": {
              "type": "number"
            }
          },
          "required": [
            "collection"
          ],
          "additionalProperties": false
        }
      ],
      "description": "Condition mini-language (docs/systems/conditions-effects.md)"
    }
  }
}
