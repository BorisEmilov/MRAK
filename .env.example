# Copy to .env and replace every "change-me" value. Never commit .env.
# These are local-development placeholders, not real secrets.

# --- Postgres superuser (container admin only; services never use it)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres

# --- online database (services/online-api)
ONLINE_DB_NAME=mrak_online
ONLINE_DB_USER=mrak_online
ONLINE_DB_PASSWORD=change-me-online

# --- studio database (services/studio-api)
STUDIO_DB_NAME=mrak_studio
STUDIO_DB_USER=mrak_studio
STUDIO_DB_PASSWORD=change-me-studio

# --- Redis
REDIS_PASSWORD=change-me-redis

# --- Host ports (change if already in use on your machine)
POSTGRES_PORT=5432
REDIS_PORT=6379

# --- Accounts (services/online-api). Production refuses to start without the first three.
# JSON array of private Ed25519 JWKs with "kid" (first one signs). Generate in the key ceremony;
# empty in development = an ephemeral key per start.
AUTH_JWT_KEYS=
# >= 32 random characters (IP salts, keyed hashes).
AUTH_SECRET=change-me-auth-secret-at-least-32-characters
# Empty in development = Cloudflare's always-pass test secret.
TURNSTILE_SECRET=
# AUTH_ISSUER=https://api.mrak.game
# AUTH_AUDIENCE=mrak-game
# APP_URL=https://play.mrak.game
# CORS_ORIGINS=https://play.mrak.game,https://mrak.game
# COOKIE_DOMAIN=mrak.game
# HIBP_ENABLED=true
# Abuse controls (docs/runbooks/abuse.md). Rate-limit overrides as JSON, e.g. {"login-ip":{"limit":40}}
# RATE_LIMITS=
# Switches that start OFF: registration,cloud-saves,telemetry,emails,purchases (runtime: Redis)
# KILL_SWITCHES=
# EMAIL_DAILY_CAP=2000
# DB_POOL_MAX=10
# DB_STATEMENT_TIMEOUT_MS=5000

# --- Services
LOG_LEVEL=info
ONLINE_API_PORT=3000
STUDIO_API_PORT=3100

# For running a service outside Docker (pnpm dev), point it at the published ports:
# DATABASE_URL=postgresql://mrak_online:change-me-online@localhost:5432/mrak_online
# REDIS_URL=redis://:change-me-redis@localhost:6379

# Game client (Vite). All optional: without them the game runs offline with the bundled content.
# Online API base URL (live seasons): e.g. http://localhost:3000
VITE_API_URL=
# CDN base URL of live content packs (serves index.json and the pack files).
VITE_CONTENT_CDN=
# Base64 raw Ed25519 PUBLIC key that signs the packs (the private key never enters the repo).
VITE_PACK_PUBLIC_KEY=

# Store (docs/systems/store.md) — Paddle sandbox in test mode
PADDLE_API_URL=https://sandbox-api.paddle.com
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_FULL_GAME=
PADDLE_PRICE_COLLECTOR=
# Paid full pack (pnpm --filter @mrak/content-schema full-pack <dir>) in the private R2 bucket
R2_HOST=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
FULL_PACK_PATH=
FULL_PACK_VERSION=
FULL_PACK_SHA256=
FULL_PACK_BYTES=
# Development only: serve the full pack locally with HMAC URLs instead of R2
FULL_PACK_LOCAL_DIR=
# Landing
PUBLIC_PADDLE_CLIENT_TOKEN=
PUBLIC_PADDLE_ENV=sandbox
# Studio sales panel (restricted role on the online database)
SALES_DATABASE_URL=
