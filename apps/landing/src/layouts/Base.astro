---
import Icon from '../components/Icon.astro';
import '@mrak/ui-kit/styles.css';
import '../styles/site.css';
import { PLAY_URL, SITE_URL } from '../data/site';
import { t, type SiteKey } from '../i18n';

interface Props {
  title?: SiteKey;
  /** Documents (Markdown pages) bring their own title. */
  docTitle?: string;
  description?: SiteKey;
  /** Keep account pages out of search engines. */
  noindex?: boolean;
}
const { title, docTitle, description = 'site.meta.description', noindex = false } = Astro.props;
const pageTitle = docTitle
  ? `${docTitle} — MRAK`
  : title
    ? `${t(title)} — MRAK`
    : t('site.meta.title');
const canonical = new URL(Astro.url.pathname, SITE_URL).href;
const ogImage = new URL('/og.png', SITE_URL).href;
const nav: [string, SiteKey][] = [
  ['/', 'site.nav.home'],
  ['/buy/', 'site.nav.buy'],
  ['/account/', 'site.nav.account'],
];
const footer: [string, SiteKey][] = [
  ['/privacy/', 'site.footer.privacy'],
  ['/terms/', 'site.footer.terms'],
  ['/refunds/', 'site.footer.refunds'],
  ['/cookies/', 'site.footer.cookies'],
  ['/press/', 'site.footer.press'],
  ['/credits/', 'site.footer.credits'],
  ['/.well-known/security.txt', 'site.footer.security'],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={t(description)} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#0e0a08" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="MRAK" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={t(description)} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t('site.meta.og-alt')} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={t(description)} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body class="mrak-root">
    <a class="skip-link" href="#main">
      {t('site.nav.skip')}
    </a>
    <header class="site-header">
      <a class="brand" href="/" aria-label={t('site.nav.home')}>
        MRAK
      </a>
      <nav aria-label={t('site.nav.label')}>
        <ul>
          {nav.map(([href, key]) => (
            <li>
              <a href={href} aria-current={Astro.url.pathname === href ? 'page' : undefined}>
                {t(key)}
              </a>
            </li>
          ))}
          <li>
            <a class="mrak-button cta-small" data-variant="primary" href={PLAY_URL}>
              <Icon name={'resource.light'} class="icon" />
              {t('site.nav.play')}
            </a>
          </li>
        </ul>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <nav aria-label={t('site.footer.label')}>
        <ul>
          {footer.map(([href, key]) => (
            <li>
              <a href={href}>{t(key)}</a>
            </li>
          ))}
        </ul>
      </nav>
      <p class="muted">{t('site.footer.note')}</p>
    </footer>
  </body>
</html>
