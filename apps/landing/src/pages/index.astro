---
import Icon from '../components/Icon.astro';
import type { IconName } from '@mrak/ui-kit';
import Island from '../components/Island.astro';
import Base from '../layouts/Base.astro';
import { FULL_PRICE, MEDIA, PLAY_URL } from '../data/site';
import { t, type SiteKey } from '../i18n';

const pillars: [IconName, SiteKey, SiteKey][] = [
  ['phase.night', 'site.pillar.dread.title', 'site.pillar.dread.text'],
  ['ui.irreversible', 'site.pillar.scars.title', 'site.pillar.scars.text'],
  ['ui.upgrade', 'site.pillar.growth.title', 'site.pillar.growth.text'],
  ['resource.sanity', 'site.pillar.doubt.title', 'site.pillar.doubt.text'],
  ['ui.history', 'site.pillar.bloodline.title', 'site.pillar.bloodline.text'],
  ['ui.hint', 'site.pillar.clear.title', 'site.pillar.clear.text'],
];
const faq: [SiteKey, SiteKey][] = [
  ['site.faq.free.q', 'site.faq.free.a'],
  ['site.faq.install.q', 'site.faq.install.a'],
  ['site.faq.account.q', 'site.faq.account.a'],
  ['site.faq.saves.q', 'site.faq.saves.a'],
  ['site.faq.price.q', 'site.faq.price.a'],
  ['site.faq.content.q', 'site.faq.content.a'],
  ['site.faq.folklore.q', 'site.faq.folklore.a'],
];
---

<Base>
  <section class="hero" aria-labelledby="hero-title">
    <div>
      <h1 id="hero-title">{t('site.home.title')}</h1>
      <p class="lead">{t('site.home.hook')}</p>
      <p class="row">
        <a class="mrak-button cta" data-variant="primary" data-guest href={PLAY_URL}>
          <Icon name={'resource.light'} class="icon" />
          {t('site.home.play')}
        </a>
        <a class="mrak-button cta" data-variant="primary" data-player hidden href="/account/">
          <Icon name={'ui.character'} class="icon" />
          {t('site.home.hub')}
        </a>
        <a href="/buy/" data-editions>
          {t('site.home.editions-link')}
        </a>
      </p>
      <p class="muted">{t('site.home.requirements')}</p>
    </div>
    <figure class="frame">
      {MEDIA.trailer ? (
        <video controls preload="none" poster={MEDIA.trailer.poster} src={MEDIA.trailer.src} />
      ) : (
        <>
          <Icon name={'phase.moon'} class="icon-lg" />
          <figcaption>{t('site.home.trailer-soon')}</figcaption>
        </>
      )}
    </figure>
  </section>

  <section aria-labelledby="story-title">
    <h2 id="story-title">{t('site.home.story-title')}</h2>
    <p class="prose">{t('site.home.story')}</p>
  </section>

  <section aria-labelledby="pillars-title">
    <h2 id="pillars-title">{t('site.home.pillars-title')}</h2>
    <ul class="pillars">
      {pillars.map(([icon, title, text]) => (
        <li>
          <Icon name={icon} class="icon-lg" />
          <h3>{t(title)}</h3>
          <p>{t(text)}</p>
        </li>
      ))}
    </ul>
  </section>

  <section aria-labelledby="media-title">
    <h2 id="media-title">{t('site.home.media-title')}</h2>
    {MEDIA.shots.length > 0 ? (
      <ul class="gallery">
        {MEDIA.shots.map((s) => (
          <li>
            <img
              src={s.src}
              alt={t(s.altKey as SiteKey)}
              width={s.width}
              height={s.height}
              loading="lazy"
              decoding="async"
            />
          </li>
        ))}
      </ul>
    ) : (
      <p class="muted">{t('site.home.media-soon')}</p>
    )}
  </section>

  <section aria-labelledby="editions-title">
    <h2 id="editions-title">{t('site.editions.title')}</h2>
    <ul class="editions">
      <li>
        <h3>{t('site.editions.demo.name')}</h3>
        <p class="price">{t('site.editions.demo.price')}</p>
        <p>{t('site.editions.demo.text')}</p>
        <a class="mrak-button" data-variant="primary" href={PLAY_URL}>
          {t('site.home.play')}
        </a>
      </li>
      <li>
        <h3>{t('site.editions.full.name')}</h3>
        <p class="price">{FULL_PRICE ?? t('site.editions.full.tba')}</p>
        <p>{t('site.editions.full.text')}</p>
        <a class="mrak-button" href="/buy/">
          {t('site.editions.details')}
        </a>
      </li>
    </ul>
  </section>

  <section aria-labelledby="faq-title">
    <h2 id="faq-title">{t('site.faq.title')}</h2>
    {faq.map(([q, a]) => (
      <details>
        <summary>{t(q)}</summary>
        <p>{t(a)}</p>
      </details>
    ))}
  </section>

  <section id="newsletter" aria-labelledby="newsletter-title" class="narrow">
    <h2 id="newsletter-title">{t('site.newsletter.title')}</h2>
    <p>{t('site.newsletter.text')}</p>
    <Island name="newsletter" />
  </section>
</Base>

<script>
  import '../islands/entry';
</script>
