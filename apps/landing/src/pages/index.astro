---
import { locales } from '@mrak/content';

const t = locales.en;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={t['landing.tagline']} />
    <title>{t['landing.title']}</title>
  </head>
  <body>
    <main>
      <h1>{t['landing.title']}</h1>
      <p>{t['landing.tagline']}</p>
    </main>
  </body>
</html>

<style>
  :global(html, body) {
    margin: 0;
    min-height: 100%;
    background: #07070a;
    color: #e8e2d4;
    font-family:
      system-ui,
      -apple-system,
      'Segoe UI',
      Roboto,
      sans-serif;
  }
  main {
    min-height: 100vh;
    display: grid;
    place-content: center;
    gap: 1rem;
    padding: 0 16px;
    text-align: center;
  }
  h1 {
    margin: 0;
    font-size: clamp(2rem, 6vw, 4rem);
    letter-spacing: 0.08em;
  }
  p {
    margin: 0;
    max-width: 40ch;
    color: #8a8478;
    line-height: 1.5;
  }
</style>
