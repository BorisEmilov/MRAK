---
import achievements from '../../../../../packages/content/data/achievements/achievements.json';
import { locales, type LocaleKey } from '@mrak/content';
import Island from '../../components/Island.astro';
import Base from '../../layouts/Base.astro';

// Names and descriptions from the game's content (hidden ones only as "???" until unlocked).
const defs = achievements.map((a) => ({
  id: a.id,
  name: locales.en[a.nameKey as LocaleKey],
  desc: locales.en[a.descKey as LocaleKey],
  hidden: 'hidden' in a && a.hidden === true,
}));

// Game names the hub shows (docs/ui/player-hub.md): guardian names, callings, attributes, zones
// and the three condition stats. Taken from the game's locale, never hardcoded.
const GAME_NAME =
  /^(name\.[\w-]+|calling\.[\w-]+\.name|attribute\.[\w-]+\.name|zone\.[\w-]+\.name|stat\.(sanity|faith|revelation)\.name)$/;
const names = Object.fromEntries(Object.entries(locales.en).filter(([k]) => GAME_NAME.test(k)));
---

<Base title="site.account.title" noindex>
  <Island name="account" props={{ achievements: defs, names }} />
</Base>

<script>
  import '../../islands/entry';
</script>
