{
  "name": "@mrak/game",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "assets": "tsx scripts/build-assets.ts",
    "art:placeholders": "tsx scripts/art/placeholders.ts",
    "dev": "pnpm assets && vite --open",
    "build": "pnpm assets && tsc --noEmit && vite build && pnpm check:demo",
    "check:demo": "tsx scripts/check-demo-build.ts",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@mrak/api-client": "workspace:*",
    "@mrak/content": "workspace:*",
    "@mrak/content-schema": "workspace:*",
    "@mrak/core": "workspace:*",
    "@mrak/ui-kit": "workspace:*",
    "idb": "8.0.3",
    "inkjs": "2.4.0",
    "phaser": "4.2.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "axe-core": "4.14.0",
    "fake-indexeddb": "6.2.5",
    "free-tex-packer-core": "0.3.9",
    "jsdom": "30.1.3",
    "tsx": "4.23.15",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
