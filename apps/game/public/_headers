# Cache policy for static hosts that read _headers (Cloudflare Pages, Netlify).
# Other CDNs: apply the same rules (docs/systems/asset-pipeline.md).

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Entry points: always revalidate so a deploy is picked up immediately.
/index.html
  Cache-Control: no-cache
/assets/manifest.json
  Cache-Control: no-cache

# Content-hashed files never change: cache for a year.
/app/*
  Cache-Control: public, max-age=31536000, immutable
/assets/atlases/*
  Cache-Control: public, max-age=31536000, immutable
/assets/audio/*
  Cache-Control: public, max-age=31536000, immutable
