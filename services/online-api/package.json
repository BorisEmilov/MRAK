{
  "name": "@mrak/online-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Public online API (accounts, cloud saves, entitlements).",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "prisma generate && eslint . --max-warnings=0",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "prisma generate && vitest run",
    "test:security": "prisma generate && vitest run src/auth src/limits src/saves src/store src/routes src/content src/middleware src/openapi.test.ts src/app.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "openapi": "tsx src/openapi.ts",
    "test:coverage": "prisma generate && vitest run --coverage",
    "keygen": "tsx --eval \"import('./src/auth/keys.ts').then(async (m) => console.log(JSON.stringify(await m.generateSigningJwk())))\""
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@sentry/node": "11.12.0",
    "argon2": "0.45.2",
    "cors": "2.8.6",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "jose": "6.2.17",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "5.1.0",
    "prisma": "7.10.1",
    "supertest": "7.3.2",
    "tsx": "4.23.15",
    "vitest": "5.1.0"
  }
}
