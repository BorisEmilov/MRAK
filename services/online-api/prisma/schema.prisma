// online database schema. Models will be added with their system specs (docs/systems/).
generator client {
  provider         = "prisma-client"
  output           = "../src/generated/prisma"
  moduleFormat     = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

/// Account progress (docs/systems/achievements.md): one row per (user, kind, key), so a repeated
/// submission never duplicates. `value` is the Legacy amount or the counter (highest wins).
model AccountProgress {
  userId    String   @map("user_id") @db.VarChar(64)
  kind      String   @db.VarChar(16)
  key       String   @db.VarChar(80)
  value     Int      @default(0)
  at        DateTime
  createdAt DateTime @default(now()) @map("created_at")

  @@id([userId, kind, key])
  @@map("account_progress")
}

/// Accounts (docs/adr/0007-tokens.md). Ids are UUIDv7 generated by the service.
model User {
  id              String    @id @db.Uuid
  /// Trimmed and lower-cased; unique.
  email           String    @unique @db.VarChar(254)
  emailVerifiedAt DateTime? @map("email_verified_at")
  passwordHash    String    @map("password_hash") @db.VarChar(255)
  displayName     String?   @map("display_name") @db.VarChar(24)
  createdAt       DateTime  @default(now()) @map("created_at")
  deletedAt       DateTime? @map("deleted_at")

  sessions    Session[]
  emailTokens EmailToken[]

  @@map("users")
}

model Session {
  id            String    @id @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  platform      String    @db.VarChar(16)
  createdAt     DateTime  @default(now()) @map("created_at")
  lastUsedAt    DateTime  @map("last_used_at")
  ipHash        String    @map("ip_hash") @db.VarChar(64)
  userAgentHash String    @map("user_agent_hash") @db.VarChar(64)
  revokedAt     DateTime? @map("revoked_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId])
  @@map("sessions")
}

model RefreshToken {
  id           String    @id @db.Uuid
  sessionId    String    @map("session_id") @db.Uuid
  familyId     String    @map("family_id") @db.Uuid
  /// SHA-256 (hex) of the opaque token; the token itself is never stored.
  tokenHash    String    @unique @map("token_hash") @db.Char(64)
  expiresAt    DateTime  @map("expires_at")
  usedAt       DateTime? @map("used_at")
  replacedById String?   @map("replaced_by_id") @db.Uuid
  revokedAt    DateTime? @map("revoked_at")

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@map("refresh_tokens")
}

model EmailToken {
  id        String    @id @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  /// verify | reset
  type      String    @db.VarChar(8)
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("email_tokens")
}

/// Security audit trail: no emails, tokens or raw IPs. userId is nulled when the account is deleted.
model AuditLog {
  id        String   @id @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  action    String   @db.VarChar(40)
  result    String   @db.VarChar(16)
  ipHash    String   @map("ip_hash") @db.VarChar(64)
  timestamp DateTime @default(now())

  @@index([userId])
  @@map("audit_log")
}
